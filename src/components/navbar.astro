---
import { getCollection } from 'astro:content'
import logo from '#assets/images/bufgreencode-logo.svg'
import icon from '#assets/images/bufgreencode-icon.svg'
import { Image } from 'astro:assets'
import SearchComponent from './search'
import MenuDrawer from './menu-drawer'
import ArticlesAccordion from './articles-accordion'

const allArticles = await getCollection('articles')
const pathname = Astro.url.pathname
---

<nav class="relative inset-x-0 flex h-14 lg:h-16 flex-shrink-0 border-b border-b-gray-200 bg-white">
  <div class="relative mx-auto w-full max-w-[1536px]">
    <div class="flex h-full items-center">
      <div class="h-full flex-shrink-0 w-16 md:w-40 lg:w-72 2xl:w-80 pl-4">
        <div class="flex h-full items-center">
          <a href="/" class="block h-full w-full py-1 lg:mr-4 lg:py-2">
            <Image transition:persist src={icon} alt="Buffalo Green Code" class="h-full w-auto md:hidden" />
            <Image transition:persist src={logo} alt="Buffalo Green Code" class="hidden md:block h-full w-auto" />
          </a>
        </div>
      </div>
      <div class="h-full flex-1 px-4 md:block md:px-8 w-full xl:w-[calc(100%-20rem)]">
        <div class="flex h-full items-center mx-auto max-w-prose w-full">
          <SearchComponent client:load />
        </div>
      </div>
      <!-- Mobile -->
      <div class="h-full items-center pr-4 flex lg:hidden">
        <MenuDrawer client:load>
          <ArticlesAccordion
            activePath={pathname}
            articles={allArticles.map((a) => ({
              id: a.id,
              data: a.data,
            }))}
            client:load
            transition:persist
          />
        </MenuDrawer>
      </div>
      <!-- Desktop -->
      <div class="hidden lg:flex h-full flex-shrink-0 items-center pr-4 text-sm font-medium xl:w-80">
        <a href="/disclaimer" class="-ml-2 px-2 py-2 text-gray-600 hover:text-gray-900 font-medium"> Disclaimer </a>
        <a
          class="flex items-center ml-2 px-2 py-2 text-gray-600 hover:text-gray-900 font-medium"
          href="/report-an-issue"
        >
          <span class="mr-1">Report an Issue</span>
        </a>
      </div>
    </div>
  </div>
</nav>
