{
  "name": "bufgreencode",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.4.0",
  "imports": {
    "#assets/*": "./src/assets/*",
    "#components/*": "./src/components/*",
    "#layouts/*": "./src/layouts/*"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "pnpm run build && npx --yes wrangler@4 dev",
    "deploy": "pnpm run build && npx --yes wrangler@4 deploy",
    "astro": "astro",
    "lint": "eslint 'src/**/*.{astro,js,jsx,ts,tsx,md,mdx,json}'",
    "prepare": "node .husky/install.mjs"
  },
  "dependencies": {
    "@ark-ui/react": "^5.39.1",
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@docsearch/css": "^5.0.5",
    "@docsearch/react": "^5.0.5",
    "@fontsource-variable/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.130",
    "@iconify/tailwind4": "^1.2.3",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "astro": "7.3.1",
    "astro-seo": "^1.2.0",
    "lodash": "^4.18.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier-plugin-astro": "^0.14.1"
  },
  "lint-staged": {
    "*.{astro,js,jsx,ts,tsx,md,mdx,json}": "eslint --fix"
  }
}
